import socket
import random
import threading

def receiveData(sock):
    while True:
        try:
            data, _ = sock.recvfrom(1024)
            print(data.decode("utf-8"))
        except:
            pass

serverIP = input("Zadajte IP servera: ")
server = (serverIP, 5678)

host = socket.gethostbyname(socket.gethostname())
port = random.randint(6000, 10000)

print("Client IP:", host, "Port:", port)

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.bind((host, port))

threading.Thread(target=receiveData, args=(s,), daemon=True).start()

name = input("Zadajte meno: ")
s.sendto(f"JOIN:{name}".encode(), server)

while True:
    msg = input()
    s.sendto(msg.encode("utf-8"), server)
